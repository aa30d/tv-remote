<?xml version="1.0" encoding="utf-8"?>
<!-- TV (D-Pad) focus ring for rectangular controls.
     Applied as android:foreground so it overlays the existing background
     without replacing it. Transparent by default, visible only when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <stroke
                android:width="2.5dp"
                android:color="#00B0F0" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
