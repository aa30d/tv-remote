<?xml version="1.0" encoding="utf-8"?>
<!-- TV (D-Pad) focus ring for round D-Pad keys.
     Applied as android:foreground so it overlays the existing background
     without replacing it. Transparent by default, visible only when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
            <stroke
                android:width="2.5dp"
                android:color="#00B0F0" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
