<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:layoutDirection="rtl">

    <!-- Main Scrollable Content with Sticky Player -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/mainCoordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_primary"
            app:elevation="0dp">

            <!-- Header (scrolls away, NOT sticky) -->
            <LinearLayout
                android:id="@+id/headerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@color/header_primary"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="16dp"
                app:layout_scrollFlags="scroll">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="23sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Sticky Player (pinned under status bar when scrolled) -->
            <FrameLayout
                android:id="@+id/stickyPlayerSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#000000"
                android:elevation="6dp"
                android:visibility="gone">

                <!-- 16:9 Player Box (reparented into fullscreenContainer on fullscreen) -->
                <FrameLayout
                    android:id="@+id/playerAspectBox"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="#000000">

                    <androidx.media3.ui.PlayerView
                        android:id="@+id/exoPlayerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:resize_mode="fit"
                        app:shutter_background_color="#000000"
                        app:surface_type="texture_view"
                        app:use_controller="false" />

                    <!-- Tap capture surface -->
                    <View
                        android:id="@+id/playerTapOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent" />

                    <!-- Loading Spinner Overlay -->
                    <LinearLayout
                        android:id="@+id/playerLoadingOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#80000000"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:indeterminateTint="@color/accent_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="در حال اتصال به پخش زنده..."
                            android:textColor="#E5FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Error Overlay -->
                    <LinearLayout
                        android:id="@+id/playerErrorOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#BF000000"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/txtPlayerError"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="خطا در پخش استریم"
                            android:textColor="@color/white"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnPlayerRetry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_sheet_btn_cyan"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="6dp"
                            android:text="تلاش مجدد"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:foreground="@drawable/fg_tv_focus" />
                    </LinearLayout>

                    <!-- Close Button (Top Right) -->
                    <ImageButton
                        android:id="@+id/btnPlayerClose"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_dark_pill"
                        android:contentDescription="بستن"
                        android:padding="6dp"
                        android:src="@drawable/ic_close"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:foreground="@drawable/fg_tv_focus" />

                    <!-- Title Overlay (Top Left) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_dark_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp">

                        <View
                            android:id="@+id/liveDot"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_live_dot" />

                        <TextView
                            android:id="@+id/txtPlayerTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Center Play/Pause Button -->
                    <ImageButton
                        android:id="@+id/btnPlayerCenterPlay"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_player_center_btn"
                        android:contentDescription="پخش یا توقف"
                        android:padding="15dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:foreground="@drawable/fg_tv_focus" />

                    <!-- Bottom Controls Bar -->
                    <LinearLayout
                        android:id="@+id/playerControlsBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_player_gradient"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="24dp"
                        android:paddingBottom="10dp">

                        <!-- Progress / Live Edge Bar -->
                        <FrameLayout
                            android:id="@+id/liveProgressContainer"
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                            android:layout_marginBottom="4dp"
                            android:layoutDirection="ltr">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="3dp"
                                android:layout_gravity="center_vertical"
                                android:background="#66FFFFFF" />

                            <View
                                android:id="@+id/liveProgressFill"
                                android:layout_width="match_parent"
                                android:layout_height="3dp"
                                android:layout_gravity="center_vertical|start"
                                android:background="@color/accent_cyan" />
                        </FrameLayout>

                        <!-- Controls Row (LTR) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layoutDirection="ltr"
                            android:orientation="horizontal">

                            <!-- Left: Prev / Play / Next -->
                            <ImageButton
                                android:id="@+id/btnPlayerPrev"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_remote_key"
                                android:contentDescription="قبلی"
                                android:padding="7dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_prev"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:foreground="@drawable/fg_tv_focus" />

                            <ImageButton
                                android:id="@+id/btnPlayerPlayPause"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_marginHorizontal="6dp"
                                android:background="@drawable/bg_remote_key"
                                android:contentDescription="پخش"
                                android:padding="6dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_pause"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:foreground="@drawable/fg_tv_focus" />

                            <ImageButton
                                android:id="@+id/btnPlayerNext"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_remote_key"
                                android:contentDescription="بعدی"
                                android:padding="7dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_next"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:foreground="@drawable/fg_tv_focus" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <!-- Right: Quality Selector + Mute + Fullscreen -->
                            <TextView
                                android:id="@+id/btnPlayerQuality"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_dark_pill"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="تطبیقی"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:foreground="@drawable/fg_tv_focus" />

                            <ImageButton
                                android:id="@+id/btnPlayerMute"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_remote_key"
                                android:contentDescription="صدا"
                                android:padding="7dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_volume_high"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:foreground="@drawable/fg_tv_focus" />

                            <ImageButton
                                android:id="@+id/btnPlayerFullscreen"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_remote_key"
                                android:contentDescription="تمام صفحه"
                                android:padding="7dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_expand"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:foreground="@drawable/fg_tv_focus" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Channels Grid + Top Action Buttons Header -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelsRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="6dp"
            android:paddingBottom="125dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:focusable="true"
            android:focusableInTouchMode="false" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Floating Remote Control Overlay System (Bottom Center) -->
    <LinearLayout
        android:id="@+id/remoteOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="22dp">

        <!-- Expanded Controls Panel + Downward Notch -->
        <LinearLayout
            android:id="@+id/remotePanelWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_remote_panel"
                android:elevation="14dp"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="10dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/remoteViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="228dp"
                    android:layoutDirection="ltr"
                    android:focusable="true"
                    android:focusableInTouchMode="false" />

                <!-- Subtle 2-Page Indicator Dots -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:layoutDirection="ltr"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dotPage1"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_ir_dot" />

                    <View
                        android:id="@+id/dotPage2"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:alpha="0.35"
                        android:background="@drawable/bg_ir_dot" />
                </LinearLayout>
            </LinearLayout>

            <!-- Notch triangle pointing down -->
            <ImageView
                android:layout_width="28dp"
                android:layout_height="14dp"
                android:layout_marginTop="-1dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_panel_notch" />
        </LinearLayout>

        <!-- Dark Floating Navigation Bar (Always Visible) -->
        <LinearLayout
            android:id="@+id/remoteBottomBar"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@drawable/bg_remote_bar"
            android:elevation="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <!-- Dots Menu Toggle -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btnRemoteMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_remote_key"
                    android:contentDescription="منوی ریموت"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ellipsis"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:foreground="@drawable/fg_tv_focus" />
            </FrameLayout>

            <!-- Volume Down -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btnRemoteVolDown"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:alpha="0.88"
                    android:background="@drawable/bg_remote_key"
                    android:contentDescription="کاهش صدا"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_volume_low"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:foreground="@drawable/fg_tv_focus" />
            </FrameLayout>

            <!-- Volume Up -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btnRemoteVolUp"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_remote_key"
                    android:contentDescription="افزایش صدا"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_volume_high"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:foreground="@drawable/fg_tv_focus" />
            </FrameLayout>

            <!-- Power + Tiny IR LED Indicator -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btnRemotePower"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_remote_key"
                    android:contentDescription="پاور"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_power"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:foreground="@drawable/fg_tv_focus" />

                <View
                    android:id="@+id/irLedDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="6dp"
                    android:alpha="0"
                    android:background="@drawable/bg_ir_dot" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Fullscreen Video Container -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:elevation="24dp"
        android:visibility="gone" />

    <!-- Floating Toast Chip (Top Left) -->
    <LinearLayout
        android:id="@+id/toastChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:background="@drawable/bg_toast_chip"
        android:elevation="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/toastIcon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginEnd="7dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check" />

        <TextView
            android:id="@+id/toastText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
