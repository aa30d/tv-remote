<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="12dp">

    <!-- Row 1: Refresh + Capture First Frame -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRefresh"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_button"
            android:elevation="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="به روز رسانی"
            android:textColor="@color/text_dark"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnCaptureFrames"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_button"
            android:elevation="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="دریافت عکس اولین فریم"
            android:textColor="@color/text_dark"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Row 2: Edit Channel Codes + Select TV Model -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnEditCodes"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_button"
            android:elevation="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="ویرایش کد کانالها"
            android:textColor="@color/text_dark"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSelectTvModel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_button"
            android:elevation="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="مدل تلویزیون: Samsung"
            android:textColor="@color/text_dark"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Row 3: Default Stream Quality Preference -->
    <TextView
        android:id="@+id/btnDefaultQuality"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_action_button"
        android:elevation="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/vazirmatn_medium"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:text="کیفیت پیش‌فرض پخش: تطبیقی (بر اساس سرعت اینترنت)"
        android:textColor="@color/text_dark"
        android:textSize="12.5sp" />

</LinearLayout>
