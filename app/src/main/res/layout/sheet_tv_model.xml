<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_bold"
                android:text="انتخاب مدل تلویزیون"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtIrStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseTvSheet"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="بستن"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:tint="#6B7280" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB" />

    <!-- Tabs + Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabTv"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_sheet_btn_cyan"
                android:fontFamily="@font/vazirmatn_bold"
                android:gravity="center"
                android:text="تلویزیون (TV)"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabCable"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_sheet_btn_white"
                android:fontFamily="@font/vazirmatn_bold"
                android:gravity="center"
                android:text="گیرنده / کابل (Cable)"
                android:textColor="@color/text_dark"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/edtBrandSearch"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_input_field"
            android:hint="جستجوی مدل (مثلاً Samsung, LG, Sony)..."
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="@color/text_dark"
            android:textColorHint="#9CA3AF"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Brand Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTvModels"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp" />

    <!-- Optional Legacy Pulse Fix checkbox -->
    <CheckBox
        android:id="@+id/chkPulseFix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:text="حالت ارسال پالس قدیمی (برای برخی گوشی‌های قدیمی)"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB" />

    <!-- Footer: Test Power + Confirm -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sheet_footer_bg"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/btnTestPower"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet_btn_white"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center"
            android:text="تست دکمه پاور"
            android:textColor="#DC2626"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnConfirmTvModel"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet_btn_cyan"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center"
            android:text="تایید و بستن"
            android:textColor="@color/white"
            android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>
